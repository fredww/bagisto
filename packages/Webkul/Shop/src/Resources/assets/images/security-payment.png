<svg width="100" height="60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60">
  <defs>
    <linearGradient id="securityGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4CAF50;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#2E7D32;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="100" height="60" rx="8" ry="8" fill="#f8f9fa" stroke="#e9ecef" stroke-width="1"/>
  
  <!-- Security Shield -->
  <g transform="translate(20, 10)">
    <!-- Shield outline -->
    <path d="M20 5 L35 10 L35 25 C35 35 20 40 20 40 C20 40 5 35 5 25 L5 10 Z" 
          fill="url(#securityGradient)" stroke="#1B5E20" stroke-width="1"/>
    
    <!-- Lock icon inside shield -->
    <g transform="translate(15, 18)">
      <!-- Lock body -->
      <rect x="2" y="6" width="6" height="8" rx="1" fill="white"/>
      <!-- Lock shackle -->
      <path d="M3 6 C3 4 4 3 5 3 C6 3 7 4 7 6" stroke="white" stroke-width="1.5" fill="none"/>
      <!-- Keyhole -->
      <circle cx="5" cy="9" r="1" fill="#2E7D32"/>
      <rect x="4.5" y="9.5" width="1" height="2" fill="#2E7D32"/>
    </g>
  </g>
  
  <!-- Text -->
  <text x="50" y="25" font-family="Arial, sans-serif" font-size="8" font-weight="bold" fill="#2E7D32" text-anchor="middle">SECURE</text>
  <text x="50" y="35" font-family="Arial, sans-serif" font-size="6" fill="#666" text-anchor="middle">PAYMENT</text>
  
  <!-- Security indicators -->
  <g transform="translate(65, 15)">
    <!-- SSL indicator -->
    <circle cx="5" cy="5" r="2" fill="#4CAF50"/>
    <text x="5" y="7" font-family="Arial, sans-serif" font-size="3" fill="white" text-anchor="middle">SSL</text>
    
    <!-- Checkmark -->
    <g transform="translate(12, 2)">
      <circle cx="3" cy="3" r="3" fill="#4CAF50"/>
      <path d="M1.5 3 L2.5 4 L4.5 2" stroke="white" stroke-width="0.8" fill="none"/>
    </g>
  </g>
</svg>